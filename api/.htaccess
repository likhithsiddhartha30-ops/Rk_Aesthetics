# Config holds the Razorpay secret: never serve it, whatever happens.
<FilesMatch "^(config|config\.sample|lib)\.php$">
    Require all denied
</FilesMatch>

# Apache 2.2 fallback for older shared hosting.
<IfModule !mod_authz_core.c>
    <FilesMatch "^(config|config\.sample|lib)\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# No directory listing of this folder.
Options -Indexes
